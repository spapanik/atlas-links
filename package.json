{
  "name": "atlas-links",
  "description": "Save, organize, and privately sync your bookmarks.",
  "private": true,
  "version": "0.1.0",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:crx": "node scripts/build-crx.mjs",
    "build:zip": "pnpm build && rm -f atlas-links.zip && cd dist && zip -qr ../atlas-links.zip .",
    "build:zip:prod": "rm -f atlas-links-web-store.zip && vite build --mode webstore && node scripts/verify-production-manifest.mjs dist/manifest.json && cd dist && zip -qr ../atlas-links-web-store.zip .",
    "format": "prettier --list-different --write .",
    "lint": "eslint . && tsc -p tsconfig.app.json --noEmit && prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fuse.js": "^7.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "crx3": "^2.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
